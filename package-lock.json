{
  "name": "roop-monorepo",
  "version": "0.4.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "roop-monorepo",
      "version": "0.4.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "packages/@your-org/*"
      ],
      "engines": {
        "node": ">=18.0.0"
      }
    },
    "node_modules/@your-org/roop-runtime": {
      "resolved": "packages/@your-org/roop-runtime",
      "link": true
    },
    "node_modules/roop-language-support": {
      "resolved": "packages/roop-vscode",
      "link": true
    },
    "packages/@your-org/roop-runtime": {
      "version": "0.4.0",
      "license": "MIT",
      "bin": {
        "roop-runtime": "src/cli/roop-runtime.js"
      },
      "devDependencies": {},
      "engines": {
        "node": ">=18.0.0"
      }
    },
    "packages/roop-vscode": {
      "name": "roop-language-support",
      "version": "0.4.0",
      "license": "MIT",
      "engines": {
        "vscode": "^1.84.0"
      }
    }
  }
}
